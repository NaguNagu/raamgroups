rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  // Models: Product fields match lib/domain.ts; Bill contains an immutable
  // item/tax/business snapshot; Enquiry contains contact data and status.
  // private/business holds revision, invoice sequence and validated settings.
  // public/settings holds business contact/hero settings only, never invoices.
  // assets/{sha256} stores immutable, size-limited public image bytes as base64.
  // No role tiers: all explicitly approved team members share full business access.
  // Sessions are keyed by UID + original authentication time; token refresh cannot
  // create a new session after two hours of inactivity or after explicit logout.
  function owner() {return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == 'sriraamrope@gmail.com';}
  function approved() {return request.auth != null && (owner() || (exists(/databases/$(database)/documents/teamMembers/$(request.auth.uid)) && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.active == true && get(/databases/$(database)/documents/teamMembers/$(request.auth.uid)).data.email == request.auth.token.email.lower()));}
  function sessionKey() {return request.auth.uid + '_' + string(request.auth.token.auth_time);}
  function liveSession(d) {return d.uid == request.auth.uid && d.authTime == request.auth.token.auth_time && d.ended == false && request.time < d.lastActive + duration.value(2,'h');}
  function admin() {return approved() && exists(/databases/$(database)/documents/authSessions/$(sessionKey())) && liveSession(get(/databases/$(database)/documents/authSessions/$(sessionKey())).data);}
  function validMember(d,id) {return d.keys().hasAll(['uid','email','name','active','createdBy','createdAt','updatedAt']) && d.keys().hasOnly(['uid','email','name','active','createdBy','createdAt','updatedAt']) && d.uid==id && text(d.uid,128) && text(d.email,254) && d.email.matches('^[^@]+@[^@]+[.][^@]+$') && d.email!='sriraamrope@gmail.com' && text(d.name,100) && d.name.size()>0 && d.active is bool && text(d.createdBy,128) && d.createdAt is timestamp && d.updatedAt==request.time;}
  function validSession(d,id) {return d.keys().hasAll(['uid','email','authTime','ended','createdAt','lastActive']) && d.keys().hasOnly(['uid','email','authTime','ended','createdAt','lastActive']) && id==sessionKey() && d.uid==request.auth.uid && text(d.uid,128) && d.email==request.auth.token.email.lower() && text(d.email,254) && d.authTime==request.auth.token.auth_time && d.authTime is int && d.ended is bool && d.createdAt is timestamp && d.lastActive is timestamp && d.lastActive<=request.time;}
  match /teamMembers/{uid} {
   allow get: if request.auth != null && (request.auth.uid==uid || admin());
   allow list: if admin();
   allow create: if admin() && validMember(request.resource.data,uid) && request.resource.data.createdBy==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.active==true;
   allow update: if admin() && uid!=request.auth.uid && validMember(request.resource.data,uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','name','updatedAt']);
  }
  match /authSessions/{id} {
   allow get: if request.auth != null && id==sessionKey();
   allow create: if approved() && validSession(request.resource.data,id) && request.resource.data.ended==false && request.resource.data.createdAt==request.time && request.resource.data.lastActive==request.time && request.time.toMillis()-request.auth.token.auth_time*1000<=300000;
   allow update: if approved() && validSession(request.resource.data,id) && liveSession(resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActive','ended']) && (request.resource.data.lastActive==request.time || request.resource.data.ended==true);
  }
  function text(v,n) {return v is string && v.size() <= n;}
  function rate(v) {return v in [0,5,12,18,28,40];}
  function image(v) {return text(v,2048) && (v in ['','rope','colour','bells','brass','tape','/business-poster.png'] || v.matches('^/product-images/[a-z-]+[.]jpg$') || v.matches('^/api/images/[a-f0-9]{64}$') || v.matches('^https://.*'));}
  function validSettings(d) {
   return d.keys().hasAll(['name','address','phone','whatsapp','email','gstin','paper','banner','heroTitle','heroText','invoicePrefix']) && d.keys().hasOnly(['name','address','phone','whatsapp','email','gstin','paper','banner','heroTitle','heroText','invoicePrefix']) && text(d.name,200) && d.name.size()>0 && text(d.address,1000) && text(d.phone,10) && d.phone.matches('^[0-9]{10}$') && text(d.whatsapp,12) && d.whatsapp.matches('^91[0-9]{10}$') && text(d.email,254) && d.email.matches('^[^@]+@[^@]+[.][^@]+$') && text(d.gstin,15) && d.paper in ['A4','A5'] && image(d.banner) && text(d.heroTitle,120) && text(d.heroText,300) && text(d.invoicePrefix,12) && d.invoicePrefix.matches('^[A-Z0-9-]{1,12}$');
  }
  function validProduct(d,id) {
   return d.keys().hasAll(['id','name','category','description','unit','price','stock','gst','hsn','image','active','createdAt','updatedAt']) && d.keys().hasOnly(['id','name','category','description','unit','price','stock','gst','hsn','image','active','sample','importNote','createdAt','updatedAt']) && d.id==id && text(d.id,100) && text(d.name,200) && d.name.size()>0 && d.category in ['Ropes','Cattle accessories','Brass & pooja','Cot tape rolls','Threads & weaving','Hardware & chains','Farm tools','Pet accessories'] && text(d.description,2000) && d.unit in ['kg','metre','piece','roll','set','bundle','pair','packet','box','unconfirmed'] && d.price is int && d.price>=0 && d.price<=100000000 && d.stock is number && d.stock>=-10000000 && d.stock<=10000000 && rate(d.gst) && text(d.hsn,8) && image(d.image) && d.active is bool && (!d.active || d.unit!='unconfirmed') && (!('importNote' in d) || text(d.importNote,1000)) && (!('sample' in d) || d.sample is bool) && d.createdAt is timestamp && d.updatedAt==request.time;
  }
  function validBill(d,id) {
   return d.keys().hasAll(['id','requestId','number','kind','date','customer','phone','address','gstin','state','items','subtotal','cgst','sgst','igst','total','units','status','business','createdAt','updatedAt']) && d.keys().hasOnly(['id','requestId','number','kind','date','customer','phone','address','gstin','state','items','subtotal','cgst','sgst','igst','total','units','status','business','createdAt','updatedAt']) && d.id==id && text(d.id,100) && text(d.requestId,36) && text(d.number,80) && d.kind in ['sale','purchase'] && text(d.date,10) && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && text(d.customer,200) && text(d.phone,20) && text(d.address,1000) && text(d.gstin,15) && text(d.state,200) && d.items is list && d.items.size()>0 && d.items.size()<=100 && d.subtotal is int && d.subtotal>=0 && d.cgst is int && d.cgst>=0 && d.sgst is int && d.sgst>=0 && d.igst is int && d.igst>=0 && d.total is int && d.total==d.subtotal+d.cgst+d.sgst+d.igst && d.units is number && d.units>0 && d.status in ['paid','unpaid'] && validSettings(d.business) && d.createdAt is timestamp && d.updatedAt==request.time;
  }
  function validEnquiry(d,id) {
   return d.keys().hasAll(['id','date','name','phone','message','status','createdAt','updatedAt']) && d.keys().hasOnly(['id','date','name','phone','message','status','createdAt','updatedAt']) && d.id==id && text(d.id,100) && text(d.date,32) && text(d.name,200) && d.name.size()>=2 && text(d.phone,10) && d.phone.matches('^[6-9][0-9]{9}$') && text(d.message,4000) && d.message.size()>=5 && d.status in ['new','contacted','closed'] && d.createdAt is timestamp && d.updatedAt==request.time;
  }
  match /products/{id} {
   allow read: if admin() || resource.data.active==true;
   allow create: if admin() && validProduct(request.resource.data,id) && request.resource.data.createdAt==request.time;
   allow update: if admin() && validProduct(request.resource.data,id) && request.resource.data.createdAt==resource.data.createdAt;
  }
  match /bills/{id} {
   allow read: if admin();
   allow create: if admin() && validBill(request.resource.data,id) && request.resource.data.createdAt==request.time;
   allow update: if admin() && validBill(request.resource.data,id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
  }
  match /enquiries/{id} {
   allow read: if admin();
   // An unauthenticated contact form may create a bounded new enquiry only.
   allow create: if validEnquiry(request.resource.data,id) && request.resource.data.status=='new' && request.resource.data.createdAt==request.time;
   allow update: if admin() && validEnquiry(request.resource.data,id) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
  }
  // Original owner report is immutable to browser clients and never public.
  match /private/openingStockReport {allow get: if admin();}
  match /private/business {
   allow read: if admin();
   function validMeta(d) {return d.keys().hasAll(['version','sequence','settings','updatedAt']) && d.keys().hasOnly(['version','sequence','settings','updatedAt']) && d.version is int && d.version>0 && d.sequence is int && d.sequence>=0 && validSettings(d.settings) && d.updatedAt==request.time;}
   allow create: if admin() && validMeta(request.resource.data) && request.resource.data.version==1;
   allow update: if admin() && validMeta(request.resource.data) && request.resource.data.version==resource.data.version+1 && request.resource.data.sequence>=resource.data.sequence;
  }
  match /public/settings {
   allow get: if true;
   allow create, update: if admin() && validSettings(request.resource.data);
  }
  match /assets/{id} {
   allow get: if true;
   allow create: if admin() && id.matches('^[a-f0-9]{64}$') && request.resource.data.keys().hasAll(['contentType','body','createdAt']) && request.resource.data.keys().hasOnly(['contentType','body','createdAt']) && request.resource.data.contentType in ['image/png','image/jpeg','image/webp'] && text(request.resource.data.body,750000) && request.resource.data.body.size()>0 && request.resource.data.createdAt==request.time;
  }
  match /{document=**} {allow read,write: if false;}
 }
}
